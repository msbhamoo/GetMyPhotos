# ---- Core ----
ENV=dev
DATABASE_URL=postgresql://gmp:gmp@postgres:5432/gmp
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
GUEST_BASE_URL=http://localhost:5173
DASHBOARD_BASE_URL=http://localhost:5174
CONSENT_VERSION=2026-09-v1
PROFILE_CONSENT_VERSION=2026-09-p1
# 32 random bytes, base64 — encrypts guest face codes. Generate:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
FACE_KEY=

# ---- Payments (Razorpay). Empty in dev = simulated payments ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Storage (MinIO locally, Cloudflare R2 in production) ----
# R2: S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=http://minio:9000
# Endpoint the browser uses for presigned URLs (same as S3_ENDPOINT on R2)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=getmyphotos

# ---- OTP ----
# DEV_OTP=true logs the code and returns it in the API response. NEVER in production.
DEV_OTP=true
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_OTP_TEMPLATE=otp_code
WA_INVITE_TEMPLATE=event_invite
WA_NEW_PHOTOS_TEMPLATE=new_photos
# Business number guests message ("PHOTOS ABC123"), digits only e.g. 919876543210
WA_BUSINESS_NUMBER=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ---- Face engine ----
FACE_MODEL=buffalo_l
FACE_DET_SIZE=640
OMP_NUM_THREADS=2
